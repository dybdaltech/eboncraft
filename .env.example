# Copy to .env.local for `npm run dev`, and to .dev.vars for `npm run preview`.

# Supabase project (Settings > API). The anon key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used to refresh stale addons in the background and to record scan results.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin, used for the OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional but recommended: a fine-grained GitHub token with public-repo read access.
# Raises the GitHub API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Optional: enables the VirusTotal scan badge (free public API key works).
VIRUSTOTAL_API_KEY=
